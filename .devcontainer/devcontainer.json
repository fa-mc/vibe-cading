{
    "name": "CadQuery Dev",
    "build": {
        // The image definition lives in docker/ — a neutral home shared with
        // docker/compose.yaml, so the container is buildable without VS Code or
        // the devcontainer CLI. This file is now purely the VS Code integration
        // layer (extensions, forwarding, mounts); it owns no image content.
        // Both paths are relative to THIS file. "context": ".." is the repo
        // root; the Dockerfile has no COPY/ADD, so the context is not actually
        // consumed — it is set to the repo root simply because that is the
        // sane, conventional scope.
        "dockerfile": "../docker/Dockerfile",
        "context": ".."
        // To pin the user to a non-1000 host UID at build time, add:
        // "args": { "USER_UID": "1001", "USER_GID": "1001" }
        // On the common path this is unnecessary: the default is UID 1000 and
        // VS Code's updateRemoteUserUID (below) re-stamps to the host UID.
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "bernhard-42.ocp-cad-viewer",
                "Anthropic.claude-code",
                "SimonSiefke.svg-preview"
            ]
        }
    },
    "forwardPorts": [
        3939
    ],
    "remoteUser": "vscode",
    "updateRemoteUserUID": true,
    // Path-identity worktree layout: mount the whole PROJECT ROOT at the identical
    // host==container path so every sibling worktree — and its .git, which points
    // back into main/.git/worktrees/ — resolves the same from host and container.
    // Open `main`; work in sibling worktrees by `cd`-ing to them within this same
    // container. Do NOT open a worktree as its own window: the CLI keys container
    // reuse on the opened folder, so that starts a SECOND container binding the
    // same ~/.claude-creds/vibe-cading/.credentials.json — reintroducing, within
    // one project, exactly the OAuth-refresh eviction race that mount prevents
    // across projects (see the credentials note below).
    //
    // `${localWorkspaceFolder}/..` is the PARENT of the opened checkout, i.e. the
    // project root. Docker normalizes the `/..` away, so both source and target
    // resolve to that root and stay identical. Derived, NOT hardcoded: a literal
    // path only works on a clone that happens to sit there, and this repo is
    // OSS — a contributor cloning anywhere else would bind a non-existent host
    // path and the container would fail to start.
    //
    // This REQUIRES the checkout to be nested one level under a project directory
    // (`<somewhere>/vibe-cading/main`) — the arrangement that makes sibling
    // worktrees possible. The requirement is not stylistic: mounting the parent
    // of a FLAT clone would bind-mount whatever directory happens to contain it,
    // read-write, under its real path. For `~/vibe-cading` that is the entire
    // home directory — handing the container `~/.ssh` read-write, while the
    // mount three entries below deliberately exposes it `readonly`. At `/vibe-cading`
    // the target resolves to `/` and the daemon refuses outright.
    //
    // initializeCommand therefore asserts the layout on the HOST and fails with
    // an explanation before any of this is used. Loud failure by design: the
    // hardcoded path this replaced failed loudly too (non-existent bind source),
    // and trading that for a silent over-broad mount would be a bad bargain.
    // Migrated 2026-06-20 from the flat /workspaces/vibe-cading layout;
    // de-hardcoded 2026-08-22.
    "workspaceMount": "source=${localWorkspaceFolder}/..,target=${localWorkspaceFolder}/..,type=bind",
    "workspaceFolder": "${localWorkspaceFolder}",
    "mounts": [
        "source=${localEnv:HOME}/.ssh,target=/tmp/host-ssh,type=bind,readonly",
        // If you override USERNAME (default "vscode") via build args, also update
        // "remoteUser" above and the /home/<user>/.claude target below — neither
        // can interpolate the Dockerfile ARG. Overriding only USER_UID/USER_GID
        // (the common non-1000-host case) needs no change here.
        "source=${localEnv:HOME}${localEnv:USERPROFILE}/.claude,target=/home/vscode/.claude,type=bind,consistency=cached",
        // Credentials isolation keyed to the PROJECT. Claude only runs in this
        // project's `main` checkout, so per-worktree granularity isn't needed — what
        // matters is isolating THIS project's token from OTHER projects' containers
        // that bind-mount the same host ~/.claude. Override ONLY .credentials.json
        // with a project-scoped host file (seeded by initializeCommand below); the
        // rest of ~/.claude (settings, memory, history) stays shared. Prevents the
        // single-use OAuth-refresh eviction race across projects. MUST stay AFTER the
        // broad ~/.claude mount above so the more-specific path wins. Keyed on the
        // literal project name, NOT ${localWorkspaceFolderBasename}: that resolves to
        // the opened folder basename (`main`), so every project's main checkout would
        // otherwise collide on ~/.claude-creds/main/.
        "source=${localEnv:HOME}${localEnv:USERPROFILE}/.claude-creds/vibe-cading/.credentials.json,target=/home/vscode/.claude/.credentials.json,type=bind,consistency=cached",
        "source=${localEnv:HOME}${localEnv:USERPROFILE}/.gemini,target=/home/vscode/.gemini,type=bind,consistency=cached"
    ],
    // Seed the per-project credentials file on first create: make the dir, then
    // copy the shared token in once (or touch an empty file if none exists yet) so
    // the nested bind mount above always has a real host file to bind. Idempotent.
    // Runs on the HOST before the container is created. Two jobs, in order:
    //
    // 1. Assert the nested layout that workspaceMount depends on. The parent of
    //    the opened folder is bind-mounted read-write, so it MUST be a project
    //    directory and not, say, your home directory. A project directory is
    //    identified by containing a `main` checkout — which also holds when a
    //    sibling worktree is the folder opened. Refusing here converts an
    //    over-broad mount into a clear, actionable message.
    // 2. Seed the per-project credentials file, because a missing bind source
    //    makes Docker create a DIRECTORY, which breaks Claude Code.
    "initializeCommand": "sh -c 'root=$(cd \"${localWorkspaceFolder}/..\" && pwd); if [ ! -d \"$root/main\" ]; then printf \"\\nERROR: expected this checkout to sit inside a project directory alongside a \\\"main\\\" checkout.\\n\\n  opened      : %s\\n  would mount : %s (read-write)\\n\\nRe-clone as <somewhere>/vibe-cading/main, or move this checkout:\\n  mkdir vibe-cading.tmp && mv <clone> vibe-cading.tmp/main && mv vibe-cading.tmp vibe-cading\\n\\n\" \"${localWorkspaceFolder}\" \"$root\" >&2; exit 1; fi' && mkdir -p ${localEnv:HOME}${localEnv:USERPROFILE}/.claude-creds/vibe-cading && { [ -f ${localEnv:HOME}${localEnv:USERPROFILE}/.claude-creds/vibe-cading/.credentials.json ] || cp ${localEnv:HOME}${localEnv:USERPROFILE}/.claude/.credentials.json ${localEnv:HOME}${localEnv:USERPROFILE}/.claude-creds/vibe-cading/.credentials.json 2>/dev/null || touch ${localEnv:HOME}${localEnv:USERPROFILE}/.claude-creds/vibe-cading/.credentials.json; }",
    "remoteEnv": {
        "SSH_AUTH_SOCK": "/ssh-agent",
        "PYTHONPATH": "${containerWorkspaceFolder}"
    },
    // SSH key copy is best-effort: copy only files the container user can READ
    // (skip root-owned files like a known_hosts written by a root-context process
    // into the shared host ~/.ssh — `cp -a` aborts postCreate with exit 1 on an
    // unreadable source). `cp -p` keeps mode/timestamps but not ownership (avoids
    // the non-root chown EPERM); the chmod steps below then normalize perms.
    "postCreateCommand": "git config --global --add safe.directory \"${containerWorkspaceFolder}\" && sudo chown -R \"$(id -u):$(id -g)\" \"${containerWorkspaceFolder}\" && mkdir -p \"$HOME/.ssh\" && { find /tmp/host-ssh -maxdepth 1 -type f -readable -exec cp -p {} \"$HOME/.ssh/\" \\; || true; } && chmod 700 \"$HOME/.ssh\" && find \"$HOME/.ssh\" -maxdepth 1 -type f ! -name '*.pub' -exec chmod 600 {} + && find \"$HOME/.ssh\" -maxdepth 1 -name '*.pub' -exec chmod 644 {} +"
}
